{
  "name": "typefolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/app",
    "apps/marketing",
    "apps/typefolio-desktop",
    "packages/core"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev:app",
    "dev:app": "npm run dev -w @typefolio/app",
    "dev:marketing": "npm run dev -w @typefolio/marketing",
    "dev:desktop": "npm run dev -w typefolio-desktop",
    "dev:native": "bash scripts/dev-all.sh",
    "dist:desktop": "npm run dist -w typefolio-desktop",
    "dist:desktop:mac": "npm run dist:mac -w typefolio-desktop",
    "dist:desktop:win": "npm run dist:win -w typefolio-desktop",
    "dist:desktop:linux": "npm run dist:linux -w typefolio-desktop",
    "upload:desktop:blob": "dotenv -e apps/marketing/.env.upload -- node scripts/upload-desktop-releases.mjs",
    "upload:desktop:blob:marketing": "npm run upload:desktop:blob",
    "build": "turbo run build",
    "start": "npm run start -w @typefolio/app",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "dotenv -e .env.local -- npm run db:push -w @typefolio/core",
    "check:env": "dotenv -e .env.local -- tsx scripts/check-env.ts",
    "polar:catalog": "dotenv -e .env.local -- tsx scripts/polar-catalog.ts",
    "polar:meters": "dotenv -e .env.local -- tsx scripts/polar-meters.ts",
    "polar:webhook": "dotenv -e .env.local -- tsx scripts/polar-webhook.ts",
    "launch:audit": "dotenv -e .env.local -- tsx scripts/launch-audit.ts",
    "vercel:env:sync": "dotenv -e .env.local -- bash scripts/sync-typefolio-vercel-env.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "test": "npm run test -w @typefolio/core"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.2",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@31.7.7": true
  }
}
