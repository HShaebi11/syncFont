# Typefolio — copy to .env.local and fill in values before running the app.
# Vercel per project: apps/app/.env.example, apps/marketing/.env.example
# Push to Vercel: ./scripts/sync-typefolio-vercel-env.sh

DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=

# Local monorepo (see docs/DEPLOYMENT.md for production hostnames)
NEXT_PUBLIC_API_URL=http://127.0.0.1:43124
BETTER_AUTH_URL=http://127.0.0.1:43124
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43124
NEXT_PUBLIC_MARKETING_URL=http://127.0.0.1:43125

# Marketing — desktop downloads (server-only on typefolio-marketing)
# Blob store origin for Next.js rewrites → https://typefolio.app/desktop/releases/*
DESKTOP_BLOB_PUBLIC_ORIGIN=
# Optional override for manifest fetch (default: {MARKETING_URL}/desktop/releases/manifest.json)
# DESKTOP_MANIFEST_URL=

BETTER_AUTH_SECRET=
# Generate: openssl rand -base64 32

# Resend
RESEND_API_KEY=
# Auth / product only (verify email, password reset)
RESEND_FROM_EMAIL=Typefolio <no-reply@typefolio.app>
# Personal thank-you note — separate verified sender in Resend (not no-reply@)
TYPEFOLIO_FOUNDER_FROM_EMAIL=
TYPEFOLIO_FOUNDER_NAME=Hamza

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar (web billing)
# Organization access token — local/.env.local only; never commit. Scopes: products, checkouts, subscriptions, webhooks.
# Provision catalog: npm run polar:catalog -- verify && npm run polar:catalog -- ensure
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_LAUNCH=
POLAR_PRODUCT_ANNUAL=
POLAR_PRODUCT_MONTHLY=
# Set true to create Pro products with: npm run polar:catalog -- ensure --with-pro
# POLAR_ENSURE_PRO=false
LAUNCH_OFFER_ACTIVE=true
# Polar Launch product trial length (days); synced via npm run polar:catalog -- ensure
LAUNCH_TRIAL_DAYS=7
# Mirror usage to Polar Meters for tracking only (not usage-based charging). Set false to disable ingest.
POLAR_USAGE_EVENTS=true

# Comma-separated Neon auth user IDs allowed to call GET /api/admin/usage
ADMIN_USER_IDS=
# Founder infra model for /api/admin/usage (GBP/month platform fixed — Vercel + Neon)
INFRA_PLATFORM_FIXED_GBP_MONTHLY=35

# Apple App Store Server Notifications v2 (iPad later)
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ENVIRONMENT=sandbox
