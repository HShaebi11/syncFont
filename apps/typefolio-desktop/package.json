{
  "name": "typefolio-desktop",
  "version": "0.1.0",
  "description": "Typefolio — Your fonts, on every device",
  "private": true,
  "homepage": "https://typefolio.app",
  "author": {
    "name": "The Interfaces",
    "email": "hello@typefolio.app"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "fix:electron-macos": "node scripts/ensure-electron.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@typefolio/core": "*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.9.1",
    "next-themes": "^0.4.6",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.3.5"
  },
  "build": {
    "electronVersion": "31.7.7",
    "appId": "company.theinterfaces.typefolio",
    "productName": "Typefolio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "maintainer": "The Interfaces <hello@typefolio.app>",
      "category": "Utility"
    },
    "protocols": [
      {
        "name": "Typefolio",
        "schemes": ["typefolio"]
      }
    ]
  }
}
