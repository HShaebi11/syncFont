# typefolio-marketing (Vercel: apps/marketing)
# Pull: cd apps/marketing && vercel link --project typefolio-marketing && vercel env pull .env.local

# --- Required (production) ---
NEXT_PUBLIC_MARKETING_URL=https://typefolio.app
NEXT_PUBLIC_API_URL=https://app.typefolio.app
NEXT_PUBLIC_APP_URL=https://app.typefolio.app

# Desktop installers (Blob rewrites → /desktop/releases/*)
DESKTOP_BLOB_PUBLIC_ORIGIN=

# --- Optional ---
# DESKTOP_MANIFEST_URL=
NEXT_PUBLIC_DESKTOP_VERSION=0.1.0
# Legacy direct download URLs if manifest is empty:
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_WIN=
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_LINUX=

# Local dev (repo root npm run dev:marketing)
# NEXT_PUBLIC_MARKETING_URL=http://127.0.0.1:43125
# NEXT_PUBLIC_API_URL=http://127.0.0.1:43124
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:43124
