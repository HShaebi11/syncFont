# typefolio-app (Vercel: apps/app)
# Pull: cd apps/app && vercel link --project typefolio-app && vercel env pull .env.local
# Local monorepo: copy from repo root .env.local (app reads ../../.env.local via dotenv in package scripts).

# --- Database & storage ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=

# --- Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.typefolio.app
NEXT_PUBLIC_API_URL=https://app.typefolio.app
NEXT_PUBLIC_APP_URL=https://app.typefolio.app
NEXT_PUBLIC_MARKETING_URL=https://typefolio.app

# --- Resend (auth emails only) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Typefolio <hello@typefolio.app>

# --- Personal founder thank-you (separate From in Resend; skip send if unset) ---
TYPEFOLIO_FOUNDER_FROM_EMAIL=
TYPEFOLIO_FOUNDER_NAME=Hamza

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Polar (web billing) ---
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_PRODUCT_ANNUAL=
POLAR_PRODUCT_LAUNCH=
POLAR_PRODUCT_MONTHLY=
LAUNCH_OFFER_ACTIVE=true

# --- Apple App Store (optional, iPad later) ---
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ENVIRONMENT=production

# Local dev (repo root npm run dev:app)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:43124
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:43124
# NEXT_PUBLIC_MARKETING_URL=http://127.0.0.1:43125
# BETTER_AUTH_URL=http://127.0.0.1:43124
